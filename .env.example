# ResumeLens Environment Configuration
# Add your Gemini API key below to enable live Gemini AI analysis.
# If no key is set, ResumeLens gracefully uses its built-in deterministic analysis engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the Gemini model (defaults to gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash
